# Server
PORT=5000
NODE_ENV=development

# MongoDB (use either MONGODB_URI or MONGO_URI)
MONGO_URI=mongodb://127.0.0.1:27017/zeromade
# MONGODB_URI=mongodb://localhost:27017/zeromade

# JWT
JWT_SECRET=change_this_secret

# CORS — must match frontend origin exactly (fixes "Failed to fetch")
# If frontend runs on port 3000: http://localhost:3000
# If frontend runs on port 3001: http://localhost:3001
CLIENT_URL=http://localhost:3000
